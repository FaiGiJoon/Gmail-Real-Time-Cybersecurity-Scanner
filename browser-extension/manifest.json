{
  "manifest_version": 3,
  "name": "Gmail Cybersecurity Scanner",
  "version": "3.1.0",
  "description": "Checks every Gmail message you open for spoofing, risky links and dangerous attachments, and shows why. No setup needed.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://safebrowsing.googleapis.com/*",
    "https://rdap.org/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["view.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["view.css", "banner.css"], "matches": ["https://mail.google.com/*"] }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gmail Cybersecurity Scanner",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_page": "options.html"
}
